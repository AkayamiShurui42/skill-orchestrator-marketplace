{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/prompt.py\"",
            "statusMessage": "Selecting skills and checking GitHub cache"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/stop.py\"",
            "statusMessage": "Auditing mandatory skill activation"
          }
        ]
      }
    ]
  }
}
